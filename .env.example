# ==============================================================================
# AutomataIQ - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME=AutomataIQ
APP_VERSION=1.0.0
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security & Authentication
SECRET_KEY=automata_super_secret_jwt_key_2026_change_in_production_!@#$
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (SQLite by default for instant local dev; swap for PostgreSQL in Docker/Prod)
DATABASE_URL=sqlite:///./automata.db
# DATABASE_URL=postgresql+asyncpg://automata:automata_secret@localhost:5432/automata_db

# Redis Cache & Background Tasks
REDIS_URL=redis://localhost:6379/0

# AI Provider API Keys (Optional: If empty, Mock/Simulation AI Provider is used automatically)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-2.5-flash

# Confidence Thresholds
CONFIDENCE_AUTO_EXECUTE_THRESHOLD=95
CONFIDENCE_MANAGER_REVIEW_THRESHOLD=80

# External Integrations (Optional / Mocks enabled if unconfigured)
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USERNAME=admin
ODOO_PASSWORD=admin

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/MOCK/TOKEN/HERE
SLACK_CHANNEL=#operations-alerts

JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=ops@company.com
JIRA_API_TOKEN=mock_jira_token
JIRA_PROJECT_KEY=OPS

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@automatai.com
SMTP_PASSWORD=mock_email_pass
EMAILS_FROM_EMAIL=alerts@automatai.com
