{
  "name": "AutomataIQ - Receivables & Dunning Engine",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "1",
      "name": "Hourly Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/api/v1/integrations/odoo/overdue-invoices",
        "authentication": "none",
        "options": {}
      },
      "id": "2",
      "name": "Fetch Overdue Invoices",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [420, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/v1/simulation/dunning/evaluate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "3",
      "name": "AI Decision & Verification Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [660, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.confidence }}",
              "operation": "largerEqual",
              "value2": 95
            }
          ]
        }
      },
      "id": "4",
      "name": "Confidence >= 95% Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/v1/integrations/email/send-dunning",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "5",
      "name": "Auto-Send Polite Dunning Notice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1140, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/v1/integrations/slack/send-approval-request",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "6",
      "name": "Request Manager Approval in Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1140, 420]
    }
  ],
  "connections": {
    "Hourly Schedule Trigger": {
      "main": [
        [
          {
            "node": "Fetch Overdue Invoices",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Overdue Invoices": {
      "main": [
        [
          {
            "node": "AI Decision & Verification Engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Decision & Verification Engine": {
      "main": [
        [
          {
            "node": "Confidence >= 95% Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confidence >= 95% Check": {
      "main": [
        [
          {
            "node": "Auto-Send Polite Dunning Notice",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Request Manager Approval in Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
